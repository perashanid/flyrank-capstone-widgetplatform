# ---- Server ----
PORT=4000
BASE_URL=http://localhost:4000
NODE_ENV=development

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
DATABASE_URL=postgres://widget_user:widget_pass@db:5432/widgetdb

# ---- Geo enrichment (fallback chain) ----
# GEO_MODE=live  -> calls the real free providers (ip-api.com, ipapi.co)
# GEO_MODE=mock  -> uses deterministic mock providers (for EVIDENCE.md proofs)
GEO_MODE=mock
# Only used when GEO_MODE=mock — toggle a provider "down" to prove the fallback
GEO_MOCK_PROVIDER_A_DOWN=false
GEO_MOCK_PROVIDER_B_DOWN=false

# ---- Email / webhook side effect ----
# EMAIL_MODE=console -> logs the confirmation instead of sending it (default, free)
# EMAIL_MODE=smtp    -> sends via SMTP (e.g. local Mailpit catcher)
EMAIL_MODE=console
SMTP_HOST=mailpit
SMTP_PORT=1025
# Force the side effect to throw, to prove it never breaks the main submission path
EMAIL_FORCE_FAIL=false

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
